# Only used when the app is installed in a subdirectory of another site (e.g. /var/www/html/sysadmin/),
# where this folder itself is on the web. Every request goes into public/, so nothing else here (.env,
# storage/, vendor/, config/...) can be fetched. Needs mod_rewrite and AllowOverride All (or FileInfo and
# AuthConfig) for this directory; without them Apache would serve the files as they are, .env included.
# A site whose DocumentRoot is public/ (like sys.localhost) never reads this file.

# Without mod_rewrite, refuse everything rather than serve the app's files.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # The URL this folder is reached at (e.g. /sysadmin/), from the request itself: rewriting to that
    # absolute URL works under an Alias and on Windows, where a relative target (public/...) can come back
    # from mod_rewrite as a file path that Apache answers with 400 Bad Request. No RewriteBase to keep up.
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=SYSADMIN_BASE:%1]

    # A trailing slash on a page (/sysadmin/ssh/) redirects to the page, as public/.htaccess does for a
    # site of its own; real folders keep theirs (Apache adds it to them).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Everything into public/, whose own .htaccess routes it (a file there, else index.php); the relative
    # form only if the URL above couldn't be worked out.
    RewriteCond %{ENV:SYSADMIN_BASE} .
    RewriteRule ^(.*)$ %{ENV:SYSADMIN_BASE}public/$1 [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
