{
    "$schema": "https://getcomposer.org/schema.json",
    "description": "System and network admin tool for monitoring servers, PHP stacks and MariaDB",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-pdo_mysql": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "leafs/blade": "^5.0",
        "leafs/mvc-core": "^5.0",
        "leafs/leaf": "^5.0",
        "leafs/logger": "^5.0",
        "leafs/schema": "^5.0",
        "leafs/csrf": "^5.0",
        "leafs/session": "^5.0",
        "leafs/cookie": "^5.0",
        "spomky-labs/otphp": "^11.5",
        "chillerlan/php-qrcode": "^6.0",
        "leafs/password": "^5.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "leafs/alchemy": "^5.0",
        "pestphp/pest": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/",
            "Config\\": "config/",
            "App\\Http\\": "app/http/",
            "App\\Data\\": "app/data/",
            "App\\DTOs\\": "app/dtos/",
            "App\\Jobs\\": "app/jobs/",
            "App\\Lang\\": "app/lang/",
            "App\\Mail\\": "app/mail/",
            "App\\Enums\\": "app/enums/",
            "App\\Views\\": "app/views/",
            "App\\Utils\\": "app/utils/",
            "App\\Rules\\": "app/rules/",
            "App\\Scopes\\": "app/scopes/",
            "App\\Events\\": "app/events/",
            "App\\Models\\": "app/models/",
            "App\\Traits\\": "app/traits/",
            "App\\Actions\\": "app/actions/",
            "App\\Mailers\\": "app/mailers/",
            "App\\Workers\\": "app/workers/",
            "App\\Console\\": "app/console/",
            "App\\Scripts\\": "app/scripts/",
            "App\\Helpers\\": "app/helpers/",
            "App\\Content\\": "app/content/",
            "App\\Channels\\": "app/channels/",
            "App\\Services\\": "app/services/",
            "App\\Database\\": "app/database/",
            "App\\Contracts\\": "app/contracts/",
            "App\\Listeners\\": "app/listeners/",
            "App\\Middleware\\": "app/middleware/",
            "App\\Components\\": "app/components/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Notifications\\": "app/notifications/",
            "App\\Database\\Seeds\\": "app/database/seeds/",
            "App\\Database\\Schema\\": "app/database/schema/",
            "App\\Database\\Factories\\": "app/database/factories/",
            "App\\Exceptions\\": "app/exceptions/"
        },
        "exclude-from-classmap": [
            "app/database/migrations"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"if (file_exists('README2.MD')) {unlink('README.MD'); rename('README2.MD', 'README.MD');}\""
        ],
        "post-create-project-cmd": [
            "@php leaf key:generate"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php leaf serve --ansi"
        ],
        "alchemy": "@php vendor/bin/alchemy all",
        "test": "@php vendor/bin/alchemy test",
        "lint": "@php vendor/bin/alchemy lint",
        "fmt": "@php vendor/bin/alchemy fmt",
        "refactor": "@php vendor/bin/alchemy refactor",
        "analyse": "@php vendor/bin/alchemy analyse",
        "ci": "@php vendor/bin/alchemy ci"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": false,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
