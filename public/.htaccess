<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # The URL this folder is reached at (/ for a site of its own, /sysadmin/public/ in a subdirectory):
    # rewriting to that absolute URL works under an Alias and on Windows (see the top-level .htaccess).
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=SYSADMIN_PUBLIC:%1]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder... (only for requests that came here directly: sent in by the
    # top-level .htaccess of a subdirectory install, REQUEST_URI is already the rewritten public/... path)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller... (the relative form only if the URL above couldn't be worked out)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{ENV:SYSADMIN_PUBLIC} .
    RewriteRule ^ %{ENV:SYSADMIN_PUBLIC}index.php [L]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
